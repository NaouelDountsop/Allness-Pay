  HeaderBackgroundColor #1E40AF
  HeaderFontColor #FFFFFF
  ArrowColor #374151
}

skinparam enum {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
  FontColor #92400E
}

skinparam note {
  BackgroundColor #F0FDF4
  BorderColor #22C55E
  FontColor #166534
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #D1D5DB
}

title **Modèle de Données — AfriLinkPay**

' ═══════════════════════════════════════════
' UTILISATEUR
' ═══════════════════════════════════════════

package "👤 UTILISATEUR" #F0F9FF {

  class User <<Entity>> #EFF6FF {
    -- Propriétés --
    idutilisateur : number  PK
    nom : string
    prenom : string
    email : string  unique
    telephone : string  unique
    datenaissance : Date
    sexe : string
    pays : string
    ville : string
    adresse : string
    profession : string
    motdepasse : string  (caché)
    googleId : string?
    statut : string  [ACTIF]
    verificationotp : boolean
    dateinscription : Date
    datemodification : Date
  }

  class Administrateur <<Entity>> #EFF6FF {
    id : number  PK
    nom : string
    email : string  unique
    motdepasse : string  (caché)
    statut : AdministrateurStatut
    createdAt : Date
    updatedAt : Date
  }
}

' ═══════════════════════════════════════════
' WALLET & TRANSACTIONS
' ═══════════════════════════════════════════

package "💰 PORTEFEUILLE" #F0FDF4 {

  class Wallet <<Entity>> #DCFCE7 {
    -- Propriétés --
    id : uuid  PK
    walletNumber : string  unique
    userId : number  FK
    balance : bigint  (centimes FCFA)
    currency : string  [XAF]
    status : WalletStatus  [INACTIVE]
    isPrimary : boolean
    label : string?
    pinHash : string?  (caché)
    pinCreatedAt : Date?
    failedPinAttempts : number
    lockedUntil : Date?
    version : number
    createdAt : Date
    updatedAt : Date
  }

  class WalletTransaction <<Entity>> #DCFCE7 {
    -- Propriétés --
    id : uuid  PK
    walletId : string  FK
    type : WalletTransactionType
    amount : bigint  (centimes FCFA)
    relatedWalletId : string?  FK
    reference : string?
    operator : LinkedAccountOperator?
    phoneNumber : string?
    description : string?
    createdAt : Date
  }
}

' ═══════════════════════════════════════════
' COMPTES LIÉS
' ═══════════════════════════════════════════

package "🔗 COMPTES EXTERNES" #FFFBEB {

  class LinkedAccount <<Entity>> #FEF3C7 {
    -- Propriétés --
    id : uuid  PK
    userId : number  FK
    walletId : string  FK
    type : LinkedAccountType
    operator : LinkedAccountOperator
    label : string
    phoneNumber : string?
    accountNumber : string?
    bankName : string?
    iban : string?
    swiftCode : string?
    currency : string  [XAF]
    status : LinkedAccountStatus  [PENDING]
    isDefault : boolean
    verifiedAt : Date?
    createdAt : Date
    updatedAt : Date
  }
}

' ═══════════════════════════════════════════
' KYC
' ═══════════════════════════════════════════

package "🪪 VÉRIFICATION D'IDENTITÉ" #FFF7ED {

  class Kyc <<Entity>> #FFEDD5 {
    -- Propriétés --
    id : number  PK
    userId : number  FK
    IdentityDocumentType : IdentityDocumentType
    proofOfAddressType : ProofOfAddressType
    documentFrontUrl : string
    documentBackUrl : string?
    selfieUrl : string
    proofOfAddressUrl : string
    status : KycStatus  [PENDING]
    reviewComment : string?
    verifiedBy : number?
    verifiedAt : Date?
    createdAt : Date
    updatedAt : Date
  }
}

' ═══════════════════════════════════════════
' TONTINE
' ═══════════════════════════════════════════

package "🤝 TONTINE" #FDF2F8 {

  class Tontine <<Entity>> #FCE7F3 {
    -- Propriétés --
    id : uuid  PK
    name : string
    description : string?
    targetAmount : bigint
    contributionAmount : bigint
    memberLimit : number
    currency : string  [XAF]
    frequency : TontineFrequency  [MONTHLY]
    status : TontineStatus  [DRAFT]
    currentCycle : number
    nextContributionAt : Date?
    creatorId : number  FK
    walletId : uuid?  FK
    version : number
    createdAt : Date
    updatedAt : Date
  }

  class TontineMember <<Entity>> #FCE7F3 {
    -- Propriétés --
    id : uuid  PK
    tontineId : uuid  FK
    userId : number  FK
    role : TontineMemberRole  [MEMBER]
    status : TontineMemberStatus  [PENDING]
    beneficiaryOrder : number?
    hasReceivedPayout : boolean
    missedContributions : number
    createdAt : Date
    updatedAt : Date
  }

  class TontineCycle <<Entity>> #FCE7F3 {
    -- Propriétés --
    id : uuid  PK
    tontineId : uuid  FK
    cycleNumber : number
    beneficiaryId : uuid
    status : TontineCycleStatus  [PENDING]
    totalPot : bigint
    collectedAmount : bigint  [0]
    dueDate : Date
    completedAt : Date?
    createdAt : Date
    updatedAt : Date
  }

  class TontineContribution <<Entity>> #FCE7F3 {
    -- Propriétés --
    id : uuid  PK
    cycleId : uuid  FK
    memberId : uuid  FK
    amount : bigint
    status : TontineContributionStatus  [PENDING]
    walletTransactionId : uuid?
    paidAt : Date?
    dueDate : Date
    penaltyCount : number
    createdAt : Date
    updatedAt : Date
  }

  class TontineInvitation <<Entity>> #FCE7F3 {
    -- Propriétés --
    id : uuid  PK
    tontineId : uuid  FK
    inviterUserId : number
    inviteeUserId : number?
    inviteeEmail : string?
    token : string  unique
    status : string  [PENDING]
    expiresAt : Date
    createdAt : Date
    updatedAt : Date
  }
}

' ═══════════════════════════════════════════
' RÔLES & PERMISSIONS
' ═══════════════════════════════════════════

