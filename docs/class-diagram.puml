' ═══════════════════════════════════════════
' ENUMS (hors packages)
' ═══════════════════════════════════════════

package "📋 ÉNUMÉRATIONS" #FAFAFA {

  enum WalletStatus {
    INACTIVE = 'inactive'
    ACTIVE = 'active'
    SUSPENDED = 'suspended'
    CLOSED = 'closed'
  }

  enum WalletTransactionType {
    DEPOSIT = 'deposit'
    WITHDRAWAL = 'withdrawal'
    TRANSFER_IN = 'transfer_in'
    TRANSFER_OUT = 'transfer_out'
  }

  enum KycStatus {
    PENDING = 'PENDING'
    UNDER_REVIEW = 'UNDER_REVIEW'
    APPROVED = 'APPROVED'
    REJECTED = 'REJECTED'
    REQUIRES_ADDITIONAL_INFO
  }

  enum IdentityDocumentType {
    NATIONAL_ID = 'NATIONAL_ID'
    PASSPORT = 'PASSPORT'
    DRIVER_LICENSE = 'DRIVER_LICENSE'
  }

  enum LinkedAccountType {
    BANK_ACCOUNT = 'bank_account'
    MOBILE_MONEY = 'mobile_money'
  }

  enum LinkedAccountOperator {
    MTN_MOMO
    ORANGE_MONEY
    WAVE
    FREE_MONEY
    MOOV_MONEY
    AIRTEL_MONEY
    BANK_APP
    OTHER
  }

  enum LinkedAccountStatus {
    PENDING = 'pending'
    ACTIVE = 'active'
    SUSPENDED = 'suspended'
    REMOVED = 'removed'
  }

  enum TontineFrequency {
    WEEKLY = 'WEEKLY'
    BIWEEKLY = 'BIWEEKLY'
    MONTHLY = 'MONTHLY'
  }

  enum TontineStatus {
    DRAFT = 'DRAFT'
    ACTIVE = 'ACTIVE'
    CLOSED = 'CLOSED'
  }

  enum TontineMemberRole {
    ADMIN = 'ADMIN'
    MEMBER = 'MEMBER'
  }

  enum TontineMemberStatus {
    PENDING = 'PENDING'
    ACTIVE = 'ACTIVE'
    SUSPENDED = 'SUSPENDED'
    LEFT = 'LEFT'
    REMOVED = 'REMOVED'
  }

  enum TontineCycleStatus {
    PENDING = 'PENDING'
    ACTIVE = 'ACTIVE'
    COMPLETED = 'COMPLETED'
    FAILED = 'FAILED'
  }

  enum TontineContributionStatus {
    PENDING = 'PENDING'
    PAID = 'PAID'
    LATE = 'LATE'
    FAILED = 'FAILED'
    REFUNDED = 'REFUNDED'
  }

  enum AdministrateurStatut {
    ACTIF = 'actif'
    SUSPENDU = 'suspendu'
  }
}

' ═══════════════════════════════════════════
' RELATIONS
' ═══════════════════════════════════════════

User "1" -- "0..*" Wallet : possède >
User "1" -- "0..*" LinkedAccount : lie >
User "1" -- "0..*" Kyc : soumet >
User "1" -- "0..*" Tontine : crée >
User "1" -- "0..*" TontineMember : rejoint >

Wallet "1" -- "0..*" WalletTransaction : enregistre >
Wallet "1" -- "0..*" LinkedAccount : est lié à >

Tontine "1" -- "1..*" TontineMember : contient >
Tontine "1" -- "0..*" TontineCycle : génère >
Tontine "1" -- "0..*" TontineInvitation : envoie >

TontineCycle "1" -- "0..*" TontineContribution : reçoit >

TontineMember "1" -- "0..*" TontineContribution : effectue >

Administrateur "1" -- "0..*" AdminRole : attribué à >
Role "1" -- "0..*" AdminRole : contient >
Role "0..*" -- "0..*" Permission : autorise >

' ═══════════════════════════════════════════
' NOTES
' ═══════════════════════════════════════════

note bottom of Wallet
  **Solde** = projection du ledger
  (jamais modifié directement)
  
  **Status** : INACTIVE → ACTIVE
  (après vérification KYC)
end note

note bottom of WalletTransaction
  **Ledger immuable** :
  Chaque opération crée
  une écriture comptable.
  
  Montants en **centimes FCFA**
  (bigint, jamais float)
end note

note bottom of Tontine
  **Cycle de vie** :
  DRAFT → ACTIVE → CLOSED
  
  **Cotisations** :
  PENDING → PAID / LATE / FAILED
end note

note right of Kyc
  **Activation wallet** :
  KYC APPROVED →
  wallet passe à ACTIVE
end note

@enduml
