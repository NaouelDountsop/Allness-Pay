# =============================================================================
# AfriLinkPay — variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le fichier `.env` ne doit JAMAIS etre committe.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
API_VERSION=1
# Origines autorisees pour le CORS, separees par des virgules
CORS_ORIGINS=http://localhost:5173

# --- Base de donnees (PostgreSQL) -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=afrilinkpay
DB_PASSWORD=afrilinkpay
DB_DATABASE=afrilinkpay
DB_SSL=false
# Toujours `false` : le schema est pilote par les migrations, jamais par la synchronisation
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis (cache, files d'attente, limitation de debit) ---------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentification --------------------------------------------------------
# Generer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret-minimum-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme-refresh-secret-minimum-32-caracteres
JWT_REFRESH_TTL=30d
# Cout de hachage Argon2 / bcrypt
PASSWORD_HASH_ROUNDS=12

# --- Limitation de debit -----------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Metier ------------------------------------------------------------------
DEFAULT_CURRENCY=XAF
# Duree de validite d'une cle d'idempotence, en secondes (24 h)
IDEMPOTENCY_TTL=86400

# --- Fournisseurs de paiement (laisser vide en local : mode simule) ----------
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# --- Email / SMTP (OTP) ------------------------------------------------------
# En dev, laisser vide : l'OTP s'affiche dans les logs du serveur.
# Pour la production, renseigner un vrai serveur SMTP (Gmail, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@afrilinkpay.com

# --- Observabilite -----------------------------------------------------------
LOG_LEVEL=debug

# --- Front-end (Vite — seules les variables VITE_* sont exposees au navigateur)
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=AfriLinkPay
